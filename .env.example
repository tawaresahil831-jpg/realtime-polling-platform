# Flask secret key for signing sessions and cookies
SECRET_KEY=replace-with-a-secure-random-secret-key

# Path to SQLite database file
DATABASE_PATH=polling.db

# Server-side salt for hashing client IP addresses
IP_HASH_SALT=replace-with-a-unique-random-salt-for-ip-hashing

# Whether to reject duplicate votes from the same IP (true / false)
ENFORCE_IP_LIMIT=true

# Server configuration
PORT=5000
FLASK_ENV=development
